# Optional archive-capable Ethereum source RPC for the local fork and tests.
# Export values in your shell before running pnpm fork / pnpm test:fork.
FORK_URL=https://eth.drpc.org
# Lower this value to reduce upstream bursts while warming a fresh fork.
FORK_CUPS=40
# Local read-only transport request ceiling; 0 disables it.
FORK_RPS=4
ETHEREUM_RPC_URL=https://eth.drpc.org
ANVIL_RPC_URL=http://127.0.0.1:8557
# FORK_BLOCK=26490939
# LOCAL_OWNER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# AAVE_DEPLOYMENT_MANIFEST=/absolute/path/contracts/config/local.json
# Deployment uses the unlocked local dev account by default.
# DEPLOYER_PRIVATE_KEY=your-local-development-key
