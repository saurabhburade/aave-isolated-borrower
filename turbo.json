{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/aave-isolated",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@aave-isolated/contracts#build": {
      "cache": false,
      "outputs": []
    }
  }
}
